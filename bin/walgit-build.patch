+/// Peer address for connections accepted by [`NodelayListener`].
+///
+/// axum implements `Connected` for `SocketAddr` only for its own `TcpListener`,
+/// and the orphan rule bars implementing a foreign trait on a foreign type, so
+/// a custom listener needs its own connect-info type.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct PeerAddr(pub SocketAddr);
+
+impl axum::extract::connect_info::Connected<axum::serve::IncomingStream<'_, NodelayListener>>
+    for PeerAddr
+{
+    fn connect_info(stream: axum::serve::IncomingStream<'_, NodelayListener>) -> Self {
+        PeerAddr(*stream.remote_addr())
+    }
+}
